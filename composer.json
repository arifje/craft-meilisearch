{
    "name": "arifje/craft-meilisearch",
    "description": "Index and search Craft elements with a hosted Meilisearch instance. Keeps your Meilisearch indexes in sync on element save/delete, exposes a JSON search endpoint, and ships a drop-in Vue 3 search component.",
    "version": "1.2.0",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "meilisearch",
        "search",
        "instant-search",
        "vue"
    ],
    "support": {
        "issues": "https://github.com/arifje/craft-meilisearch/issues",
        "source": "https://github.com/arifje/craft-meilisearch"
    },
    "require": {
        "php": ">=8.0.2",
        "ext-json": "*",
        "craftcms/cms": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "arifje\\craftmeilisearch\\": "src/"
        }
    },
    "extra": {
        "handle": "meilisearch",
        "name": "Meilisearch",
        "developer": "arifje",
        "developerUrl": "https://github.com/arifje",
        "documentationUrl": "https://github.com/arifje/craft-meilisearch",
        "class": "arifje\\craftmeilisearch\\Plugin"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
